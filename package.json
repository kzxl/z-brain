{
  "name": "z-brain",
  "version": "1.2.0",
  "description": "Z-Brain — Zero-overhead local episodic knowledge engine and Antigravity/ZCode plugin for AI coding agents with SQLite FTS5 progressive disclosure (L0 Index / L2 View)",
  "main": "server.js",
  "scripts": {
    "cli": "node plugins/z-brain/scripts/cli.mjs",
    "mcp": "node plugins/z-brain/scripts/mcp-server.mjs",
    "install:plugin": "powershell -ExecutionPolicy Bypass -File install.ps1",
    "start": "node server.js",
    "dev": "node --watch server.js",
    "proxy": "node openai-proxy.js",
    "find-qa": "node tools/find-qa.js",
    "find-qa-context": "node tools/find-qa-context.js",
    "find-qa-deep": "node tools/find-qa-deep.js",
    "view-qa": "node tools/view-qa.js",
    "save-qa": "node tools/save-qa.js",
    "ingest": "node tools/ingest-knowledge.js",
    "post-task": "node tools/post-task.js",
    "curate": "node tools/curate.js",
    "health": "node tools/qa-health.js",
    "dashboard": "node tools/dashboard.js",
    "stats": "node tools/stats.js",
    "setup": "node maintenance/setup.js",
    "migrate": "node migrations/run.js",
    "test": "node --test tests/",
    "verify:phase0": "node tools/verify-phase0.js",
    "verify:phase1": "node tools/verify-phase1.js",
    "verify:phase2": "node tools/verify-phase2.js",
    "verify:phase3": "node tools/verify-phase3.js",
    "bench:ann50k": "node tools/benchmark-ann-50k.js",
    "review:scope": "node tools/review-scope.js",
    "trust:promote": "node tools/promote-trust.js",
    "baseline": "node tools/baseline.js",
    "export": "node maintenance/export.js",
    "import": "node maintenance/import.js"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "dotenv": "^17.4.2",
    "pg": "^8.13.0"
  }
}
